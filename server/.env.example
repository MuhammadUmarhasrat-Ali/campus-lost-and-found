# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# If left blank or connection fails, an automatic in-memory MongoDB will be used for zero-friction local development!
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found

# JWT Secret
JWT_SECRET=campus_lost_found_super_secure_jwt_secret_key_2026

# Cloudinary Image Storage
# If left blank, item photos will be stored locally in /uploads folder
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (Nodemailer)
# If left blank, password reset tokens will be logged to console and returned in dev mode
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Campus Lost & Found" <noreply@campuslostfound.edu>

# Optional Approved College Domain (leave blank to allow all emails, or set to e.g. "college.edu")
APPROVED_EMAIL_DOMAIN=

